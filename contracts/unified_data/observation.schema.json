  "required": [
    "semantic",
    "fact_revision",
    "observation_id",
    "source_game_id",
    "provenance",
    "membership"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nba-stats-desk:unified-observation:1",
  "title": "Offline provider-separated normalized game observation",
  "allOf": [
    {
      "if": {
        "properties": {
          "semantic": {
            "properties": {
              "provider": {
                "const": "nba_api"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_game_id": {
            "pattern": "^00225[0-9]{5}$"
          },
          "source_chain": false,
          "semantic": {
            "properties": {
              "adapter_version": {
                "const": "nba_archive_observation/1"
              },
              "source_definition": {
                "const": "nba_game_logs_reported_v1"
              },
              "scope": {
                "properties": {
                  "season": {
                    "const": "2025-26"
                  }
                }
              },
              "identity_bindings": false
            }
          }
        }
      },
      "else": {
        "required": [
          "source_chain"
        ],
        "properties": {
          "source_game_id": {
            "pattern": "^[1-9][0-9]{0,15}$"
          },
          "semantic": {
            "required": [
              "identity_bindings"
            ],
            "properties": {
              "adapter_version": {
                "const": "espn_retained_observation/1"
              },
              "source_definition": {
                "const": "espn_summary_reported_v1"
              },
              "scope": {
                "properties": {
                  "season": {
                    "const": "2026-27"
                  }
                }
              },
              "membership_level": {
                "const": "provider_declared_complete"
              },
              "date_basis": false
            }
          },
          "date_review": false
        }
      }
    },
    {
      "if": {
        "required": [
          "date_review"
        ]
      },
      "then": {
        "properties": {
          "semantic": {
            "required": [
              "date_basis"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "semantic": {
            "properties": {
              "date_basis": false
            }
          }
        }
      }
    }
  ]
}
