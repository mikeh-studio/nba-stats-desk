            "game_id": {
              "type": "string",
              "pattern": "^00225[0-9]{5}$"
            },
            "original_input_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "old_date": {
              "type": "string",
              "format": "date"
            },
            "played_date": {
              "type": "string",
              "format": "date"
            },
            "scope": {
              "type": "object",
              "properties": {
                "league": {
                  "const": "nba"
                },
                "season": {
                  "enum": [
                    "2025-26",
                    "2026-27"
                  ]
                },
                "phase": {
                  "const": "Regular Season"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "home": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "away": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              },
              "required": [
                "league",
                "season",
                "phase",
                "date",
                "home",
                "away"
