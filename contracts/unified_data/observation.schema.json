                      "player_id": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "team": {
                        "type": "string"
                      },
                      "played": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "player_id",
                      "team",
                      "played"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "sha256",
                "evidence",
                "participants"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "level",
        "participant_manifest"
      ],
      "additionalProperties": false
