                "receipt": {
                  "type": "object",
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "captured_at": {
                      "type": [
                        "string",
