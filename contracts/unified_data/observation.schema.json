                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "blk": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "tov": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "pf": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "plus_minus": {
                    "type": [
                      "integer",
                      "null"
