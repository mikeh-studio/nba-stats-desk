{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "publication-manifest/2"
    },
    "publication_id": {
      "type": "string",
      "pattern": "^pub_[0-9a-f]{16}$"
    },
    "profile": {
      "const": "core_stats_weekly_v1"
    },
    "purpose": {
      "enum": [
        "offline_replay",
        "staging",
        "production"
      ]
    },
    "evidence_kind": {
      "enum": [
        "synthetic",
        "retained"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "producer_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "data_package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "dbt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "semantics": {
          "const": "nba_semantics/0.1"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source_policy": {
          "enum": ["unified_source_selection/1", "nba_manual_selection/1"]
        }
      },
      "required": [
        "public_code",
        "producer_code",
        "data_package",
        "dbt",
        "semantics",
        "identity",
        "source_policy"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "season": {
          "type": "string",
          "pattern": "^20[2-3][0-9]-[0-9]{2}$"
        },
        "phase": {
          "const": "Regular Season"
        },
        "first": {
          "type": "string",
          "format": "date"
        },
        "last": {
          "type": "string",
          "format": "date"
        },
        "provider": {
          "enum": ["espn", "nba_api"]
        }
      },
      "required": [
        "season",
        "phase",
        "first",
        "last",
        "provider"
      ]
    },
    "built_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "validation_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "data_through": {
      "type": "string",
      "format": "date"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "selection",
              "discovery",
              "identity",
              "ledger",
              "reference",
              "source_authority",
              "correction_authority"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "storage_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "evidence_kind": {
            "enum": [
              "synthetic",
              "retained"
            ]
          }
        },
        "required": [
          "role",
          "digest",
          "version",
          "storage_ref",
          "captured_at",
          "evidence_kind"
        ]
      }
    },
    "selected_games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "game_uid": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "game_id": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "observation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fact_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "box_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "mapping_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "last_verified_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "participants": {
            "type": "integer",
            "minimum": 0
          },
          "played": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "game_uid",
          "game_id",
          "observation_id",
          "fact_revision",
          "result_revision",
          "box_revision",
          "decision_id",
          "mapping_version",
          "captured_at",
          "last_verified_at",
          "participants",
          "played"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_games": {
          "type": "integer",
          "minimum": 0
        },
        "observed_games": {
          "type": "integer",
          "minimum": 0
        },
        "expected_participants": {
          "type": "integer",
          "minimum": 0
        },
        "observed_participants": {
          "type": "integer",
          "minimum": 0
        },
        "played_rows": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_identities": {
          "const": 0
        },
        "open_required_holds": {
          "const": 0
        },
        "observed_players": {
          "type": "integer",
          "minimum": 1
        },
        "observed_teams": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "expected_games",
        "observed_games",
        "expected_participants",
        "observed_participants",
        "played_rows",
        "unresolved_identities",
        "open_required_holds",
        "observed_players",
        "observed_teams"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "game_id",
              "player_id",
              "player_name",
              "team_abbr",
              "opponent_abbr",
              "home_away",
              "game_date",
              "matchup",
              "season",
              "season_type",
              "wl",
              "min",
              "fgm",
              "fga",
              "fg_pct",
              "ftm",
              "fta",
              "ft_pct",
              "fg3m",
              "fg3a",
              "plus_minus",
              "pf",
              "oreb",
              "dreb",
              "pts",
              "reb",
              "ast",
              "stl",
              "blk",
              "tov",
              "fantasy_points_simple",
              "ingested_at_utc"
            ]
          },
          "status": {
            "enum": [
              "complete",
              "nullable"
            ]
          },
          "missing_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "status",
          "missing_count"
        ]
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "accepted_game_results",
              "accepted_player_appearances",
              "participant_manifest",
              "fct_player_game_stats",
              "fct_team_game_results",
              "dim_game",
              "dim_player",
              "dim_team",
              "core_player_summary",
              "core_player_windows",
              "core_player_trends",
              "core_performance",
              "core_player_search"
            ]
          },
          "relation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{4,62}\\.[A-Za-z_][A-Za-z0-9_]{0,100}\\.[A-Za-z_][A-Za-z0-9_]{0,100}$"
          },
          "schema_version": {
            "const": "core_stats_weekly_v1"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "dependencies": {
            "type": "array",
            "minItems": 0,
            "items": {
              "enum": [
                "accepted_game_results",
                "accepted_player_appearances",
                "participant_manifest",
                "fct_player_game_stats",
                "fct_team_game_results",
                "dim_game",
                "dim_player",
                "dim_team",
                "core_player_summary",
                "core_player_windows",
                "core_player_trends",
                "core_performance",
                "core_player_search"
              ]
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
            }
          },
          "built_from": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "relation",
          "schema_version",
          "digest",
          "rows",
          "dependencies",
          "fields",
          "built_from"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "player_core",
          "compare_core",
          "performance_core",
          "ask_player_stats",
          "player_search",
          "team_results_sql"
        ]
      },
      "minItems": 6
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "identity",
              "source_authority",
              "source_selection",
              "coverage",
              "participation",
              "correction_holds",
              "freshness",
              "field_semantics",
              "dependency_closure",
              "content_digests"
            ]
          },
          "status": {
            "const": "passed"
          },
          "receipt_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "status",
          "receipt_digest"
        ]
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "weekly_8d_10d_v1"
        },
        "discovery_verified_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_valid_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "policy",
        "discovery_verified_at",
        "source_valid_until",
        "expires_at"
      ]
    },
    "auxiliary": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "enum": [
              "schedule",
              "injury",
              "positions",
              "shots",
              "similarity",
              "gamebook_pdf",
              "pbp",
              "research_context"
            ]
          },
          "status": {
            "const": "disabled"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "domain",
          "status",
          "reason"
        ]
      }
    },
    "materialized_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "allocation_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "version",
    "publication_id",
    "profile",
    "purpose",
    "evidence_kind",
    "run_id",
    "build_id",
    "input_fingerprint",
    "versions",
    "scope",
    "built_at",
    "validation_as_of",
    "data_through",
    "inputs",
    "selected_games",
    "coverage",
    "fields",
    "assets",
    "capabilities",
    "checks",
    "freshness",
    "auxiliary",
    "materialized_at",
    "allocation_key"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed publication manifest; schema validity is not source authority"
}
